# Copy this file to .env and fill with your real values.
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Core model/provider settings
GROQ_MODEL=groq/compound-mini
GROQ_MODEL_CANDIDATES=groq/compound-mini,llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b
MODEL_NAME=groq/compound-mini
MODEL_FALLBACKS=groq/compound-mini,llama-3.1-8b-instant

LOG_LEVEL=INFO
MODEL_NAME_GEM=models/gemini-flash-latest
MODEL_NAME_GROQ=models/groq-1.5-turbo
MODEL_FALLBACKS_GROQ=models/groq-1.5-turbo,models/groq-1.0-turbo
MODEL_FALLBACKS_GEM=models/gemini-flash-latest,models/gemma-3-1b-it,models/gemini-2.0-flash-lite-001,models/gemini-2.5-flash-lite,models/gemini-2.0-flash,models/gemini-2.5-flash

AI_PROVIDER=openrouter
AI_PROVIDER_FALLBACKS=openrouter,groq,gemini

# Router Universal (OpenRouter o Requesty.ai)
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_API_KEY=your_openrouter_or_requesty_key_here
ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
ROUTER_MODEL_CANDIDATES=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

PROVIDER_QUOTA_TTL=300

