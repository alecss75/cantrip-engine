# Copy this file to .env and fill with your real values.
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Core model/provider settings (modelos vivos; Llama 3.3 se retiró el 2026-08-16)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_CANDIDATES=qwen/qwen3.8-27b,openai/gpt-oss-120b
MODEL_NAME=models/gemini-2.5-flash
MODEL_FALLBACKS=models/gemini-2.5-flash,models/gemini-2.5-flash-lite

LOG_LEVEL=INFO
MODEL_NAME_GEM=models/gemini-2.5-flash
MODEL_FALLBACKS_GEM=models/gemini-2.5-flash,models/gemini-2.5-flash-lite

AI_PROVIDER=openrouter
AI_PROVIDER_FALLBACKS=openrouter,groq,gemini

# Groq / modo compacto (presupuesto de tokens por minuto)
# La capa gratuita de Groq son 8.000 TPM y se cobran como entrada + salida reservada.
#   auto = compacta solo si el prompt completo no cabe
#   on   = compacta siempre que el proveedor sea Groq
#   off  = nunca compacta (reproduce el 413 para diagnóstico)
# Dev Tier: sube GROQ_TPM_LIMIT y, si quieres prosa más larga, GROQ_COMPACT_MAX_OUTPUT.
GROQ_TPM_LIMIT=8000
GROQ_COMPACT_MODE=auto
GROQ_COMPACT_MAX_INPUT=5400
GROQ_COMPACT_MAX_OUTPUT=1000

# Estimador de tokens: 3,5 chars/token, calibrado con los prompt_tokens reales que
# devuelve Groq para los textos del motor (texto plano ASCII llega a 7,4).
PROMPT_ESTIMATOR_CHARS_PER_TOKEN=3.5
PROMPT_ESTIMATOR_MARGIN=0.05

# Router Universal (OpenRouter o Requesty.ai)
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_API_KEY=your_openrouter_or_requesty_key_here
ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
ROUTER_MODEL_CANDIDATES=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# TTL de enfriamiento por cuota cuando el proveedor NO envía Retry-After (segundos)
PROVIDER_QUOTA_TTL=300
